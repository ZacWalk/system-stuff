#include "resource.h"
#include <winres.h>

IDI_LIGHT      ICON "res\\sys-stuff.ico"
IDI_DARK ICON "res\\sys-stuff-dark.ico"

IDR_ACCEL ACCELERATORS
BEGIN
    VK_F5,      1,    VIRTKEY, NOINVERT
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "System Stuff - System Information Utility"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "System Stuff"
            VALUE "LegalCopyright", "Copyright (C) 2002 Zac Walker"
            VALUE "OriginalFilename", "sys-stuff.exe"
            VALUE "ProductName", "System Stuff"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END